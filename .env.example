# ==============================================================================
# OptiFuel USA - Environment Configuration Template (.env.example)
# ==============================================================================

# 1. Django Core Configuration
DJANGO_SECRET_KEY=your-django-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*,127.0.0.1,localhost

# 2. Server Settings
HOST=127.0.0.1
PORT=8000

# 3. Routing & Geocoding APIs
OSRM_BASE_URL=http://router.project-osrm.org/route/v1/driving
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_USER_AGENT=OptiFuelUSA/1.0 (contact: admin@fuelrouteoptimizer.local)

# Optional commercial API keys (Free OSRM/Nominatim used if blank)
OPENROUTESERVICE_API_KEY=
MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=

# 4. Vehicle & Fuel Optimization Constraints
DEFAULT_MAX_RANGE_MILES=500.0
DEFAULT_FUEL_EFFICIENCY_MPG=10.0
CORRIDOR_SEARCH_RADIUS_MILES=12.0
SAFETY_BUFFER_MILES=40.0

# 5. Data Paths
FUEL_DATA_CSV_PATH=documemnts/fuel-prices-for-be-assessment.csv
FUEL_DATA_JSON_PATH=fuel_optimizer/data/fuel_stations.json
